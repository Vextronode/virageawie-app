root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP, JS, TS, JSON, and CSS use the default of 4 spaces, matching src/.editorconfig
# and the formatters (Pint, Oxfmt). YAML uses 2.
[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Caddyfile]
indent_style = tab
