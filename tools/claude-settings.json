{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./src/.env)",
      "Read(./src/.env.*)",
      "Read(./infra/.env)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan db:wipe:*)"
    ],
    "ask": [
      "Bash(composer require:*)",
      "Bash(npm install:*)",
      "Bash(git -C:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)"
    ]
  }
}
