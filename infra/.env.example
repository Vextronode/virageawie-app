# Copy to infra/.env on the server and replace every placeholder.
# infra/.env is git-ignored. Never commit real values.

# Image (set by the deploy workflows; never "latest")
APP_IMAGE=ghcr.io/example-owner/virageawie-app
APP_IMAGE_TAG=v0.0.0

# Edge proxy (compose.edge.yaml)
ACME_EMAIL=ops@example.com
PROD_APP_HOST=app.virageawie.com
STAGING_APP_HOST=staging-app.virageawie.com

# Production application (compose.prod.yaml)
PROD_APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_--show
PROD_LOG_LEVEL=warning
PROD_DB_DATABASE=virageawie
PROD_DB_USERNAME=virageawie
PROD_DB_PASSWORD=change-me-prod-db-password
PROD_MAIL_MAILER=smtp
PROD_MAIL_HOST=smtp.example.com
PROD_MAIL_PORT=587
PROD_MAIL_USERNAME=change-me
PROD_MAIL_PASSWORD=change-me
PROD_MAIL_FROM_ADDRESS=no-reply@example.com

# Production backup to Cloudflare R2 (compose.prod.yaml, service "backup")
BACKUP_AGE_RECIPIENT=age1replacewithpublickey
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE="0 2 * * *"
R2_ACCOUNT_ID=change-me-account-id
R2_ACCESS_KEY_ID=change-me-access-key-id
R2_SECRET_ACCESS_KEY=change-me-secret-access-key
R2_BUCKET=virageawie-backups
R2_PREFIX=postgres

# Staging application (compose.staging.yaml)
STG_APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_--show
STG_LOG_LEVEL=info
STG_DB_DATABASE=virageawie_staging
STG_DB_USERNAME=virageawie
STG_DB_PASSWORD=change-me-staging-db-password
STG_MAIL_MAILER=log
STG_MAIL_HOST=
STG_MAIL_PORT=587
STG_MAIL_USERNAME=
STG_MAIL_PASSWORD=
STG_MAIL_FROM_ADDRESS=no-reply@example.com
